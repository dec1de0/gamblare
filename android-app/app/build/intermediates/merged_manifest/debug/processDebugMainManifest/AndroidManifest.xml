<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="kz.hackathon.ludoguard"
    android:versionCode="1"
    android:versionName="0.1.0" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="35" />

    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="false"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:label="LudoGuard"
        android:supportsRtl="true"
        android:theme="@style/Theme.LudoGuard" >
        <activity
            android:name="kz.hackathon.ludoguard.InterventionActivity"
            android:excludeFromRecents="true"
            android:exported="false" />
        <activity
            android:name="kz.hackathon.ludoguard.WebAppActivity"
            android:exported="false" />
        <activity
            android:name="kz.hackathon.ludoguard.MainActivity"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="kz.hackathon.ludoguard.UsageMonitorService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name="kz.hackathon.ludoguard.WebsiteVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE" >
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>

            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="DNS domain monitoring with explicit user consent" />
        </service>
    </application>

</manifest>